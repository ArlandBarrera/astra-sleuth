{
  "name": "earth-sleuth-orbis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "start": "vite --host",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
