    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:engine": "cd engine && cargo test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@observablehq/plot": "^0.6.19",
    "@watergis/maplibre-gl-terradraw": "^1.17.0",
    "d3-geo": "^3.1.2",
    "maplibre-gl": "^6.18.0",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "topojson-client": "^3.1.0",
    "uplot": "^1.6.32",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
